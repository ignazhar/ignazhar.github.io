---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ViewCount from '../../components/ViewCount.astro';
import Comments from '../../components/Comments.astro';
import { getPosts, formatDate, readingTime } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, description, cover, tags } = post.data;
---

<Base title={title} description={description}>
  <article class="prose">
    <h1>{title}</h1>
    <div class="post-meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span class="dot"></span>
      <span>{readingTime(post.body)} min read</span>
      <ViewCount />
    </div>

    {cover && <Image class="cover" src={cover} alt="" loading="eager" widths={[720, 1440]} sizes="(max-width: 720px) 100vw, 720px" />}

    <Content />

    {
      tags.length > 0 && (
        <div class="tags">
          {tags.map((t) => (
            <span class="tag">#{t}</span>
          ))}
        </div>
      )
    }
  </article>

  <Comments />
</Base>
