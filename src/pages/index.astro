---
// Home page. The text at the top comes from src/content/home.md — edit that file,
// not this one. Below it: recent posts and the total visit counter.
import Base from '../layouts/Base.astro';
import ViewCount from '../components/ViewCount.astro';
import { Content as Intro } from '../content/home.md';
import { getPosts, formatDate } from '../lib/posts';

const recent = (await getPosts()).slice(0, 5);
---

<Base>
  <article class="prose">
    <Intro />
  </article>

  <h2 class="section-title">Recent writing</h2>
  <ul class="post-list">
    {
      recent.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        </li>
      ))
    }
  </ul>
  <p class="small"><a href="/blog/">All posts →</a></p>

  <p class="small muted"><ViewCount total label="total visits to this site" /></p>
</Base>
